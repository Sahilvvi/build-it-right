# Supabase -> Project Settings -> API
# Public values (safe in the browser; protected by Row Level Security):
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY. Never prefix with VITE_. Used solely to create admin accounts from /admin/users.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public origin of the site, no trailing slash. Makes og:image / canonical URLs absolute.
VITE_SITE_URL=https://www.example.com
