# ───────────────────────────── Supabase (Project Settings → API) ─────────────────────────────
# Public values: safe in the browser, protected by Row Level Security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# SERVER ONLY. Never prefix with VITE_. Used to create admin accounts, accept website enquiries
# (rate-limited) and send test emails.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ───────────────────────────── Site ─────────────────────────────
# Public origin, no trailing slash. Makes og:image / canonical / sitemap URLs absolute.
VITE_SITE_URL=https://www.example.com

# ───────────────────────────── Email alerts for new enquiries ─────────────────────────────
# The SMTP host / port / username / recipient are set in Admin → System Settings.
# The PASSWORD is only ever read from here (for Gmail use an App Password).
SMTP_PASS=

# ───────────────────────────── Spam protection (optional) ─────────────────────────────
# Cloudflare Turnstile. Leave both empty to disable; set both to enable.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
